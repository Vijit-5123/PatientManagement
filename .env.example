# Example environment variable overrides for the backend (PatientManagement.Api).
# ASP.NET Core maps double-underscore env vars to nested configuration keys.
# Copy this file to `.env` and load it into your shell/session if you prefer
# environment variables over appsettings.*.json. None of these are required
# for local development — safe defaults already exist in
# backend/PatientManagement.Api/appsettings.Development.json.

# SQLite database file location
ConnectionStrings__DefaultConnection=Data Source=app.db

# JWT signing configuration (NEVER reuse the dev secret in a real deployment)
Jwt__Secret=dev-only-super-secret-signing-key-do-not-use-in-production-1234567890
Jwt__Issuer=PatientManagement.Api
Jwt__Audience=PatientManagement.Client
Jwt__ExpiryMinutes=60

# CORS - allowed Angular dev-server origin
Cors__AllowedOrigins__0=http://localhost:4200

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
